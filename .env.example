# ─────────────────────────────────────────────────────────────────────────────
# TrackMyRMC (CONCRETE KING) — Example environment configuration
#
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# On Replit, these are managed as Secrets — do not paste real values here.
# Variables prefixed with VITE_ are read by the frontend (rmc-app) at build time;
# everything else is read by the backend (server) at runtime.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Backend port. Cloud Run / Replit deploy inject PORT; API_PORT is the dev fallback.
PORT=5000
API_PORT=3001
# PostgreSQL connection string (required at boot).
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Required at boot — no fallback. Use a long random string.
JWT_SECRET=
# Public origin(s) used for links in emails, webhooks and CORS.
APP_URL=https://your-domain.example
PUBLIC_URL=https://your-domain.example
# Comma-separated list of allowed CORS origins (production-safe; no wildcard).
CORS_ALLOWED_ORIGINS=https://your-domain.example

# ── Object storage (Replit Object Storage) ───────────────────────────────────
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── Bootstrap admin / app-store reviewer demo ────────────────────────────────
AUTHORITY_BOOTSTRAP_PASSWORD=
# Comma-separated emails granted the authority role on boot.
AUTHORITY_EMAILS=
# Fixed reviewer demo login (staff OTP bypass). Leave blank to disable.
REVIEW_DEMO_EMAIL=
REVIEW_DEMO_OTP=

# ── Clerk SSO (optional; browser SSO → legacy JWT exchange) ───────────────────
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ── Google Maps / Places ─────────────────────────────────────────────────────
# Browser key (preferred, domain-restricted) enables Maps JS + Geocoding.
GOOGLE_MAPS_BROWSER_KEY=
# Server key for Places API (New) discovery. Falls back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
# Optional cloud-styled Map ID.
GOOGLE_MAPS_MAP_ID=

# ── Gemini AI (Replit integration) ───────────────────────────────────────────
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# ── SMTP email (notifications) ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notification@your-domain.example
# When 1, boot syncs SMTP_* from env into app_settings and verifies the connection.
SMTP_SYNC_FROM_ENV=0

# ── Twilio (customer SMS OTP / WhatsApp / Verify) ────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# ── WhatsApp Meta Cloud API (templates + inbound webhook) ────────────────────
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_LANG=en
WHATSAPP_META_OTP_TEMPLATE=

# ── Web push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.example

# ── KYC (Aadhaar eKYC aggregator) ────────────────────────────────────────────
KYC_ENABLED=false
KYC_PROVIDER=
KYC_BASE_URL=
KYC_API_KEY=
KYC_API_SECRET=
KYC_API_VERSION=

# ── Live GPS ─────────────────────────────────────────────────────────────────
# Milliseconds after which a driver's last GPS fix is considered stale.
LIVE_GPS_STALE_MS=120000

# ── Frontend (rmc-app) ───────────────────────────────────────────────────────
# Empty = same-origin (web). Set to the API origin for the native Android build.
VITE_API_BASE_URL=
# Set to 1 for the Capacitor/native build (disables the PWA service worker).
VITE_NATIVE=
