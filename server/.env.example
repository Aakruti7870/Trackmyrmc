# Core server configuration
DATABASE_URL=
JWT_SECRET=
APP_URL=https://trackmyrmc.com
CORS_ALLOWED_ORIGINS=

# Google Places API (New) — server-side only. Store the production value in
# Google Secret Manager and inject it into Cloud Run; never expose as VITE_*.
GOOGLE_PLACES_API_KEY=

# Maharashtra RMC import controls
RMC_IMPORT_MAX_CONCURRENCY=3
RMC_IMPORT_RETRY_LIMIT=3
RMC_IMPORT_MARKET_COOLDOWN_HOURS=168
RMC_IMPORT_MIN_CONFIDENCE_SCORE=45
RMC_DUPLICATE_RADIUS_METERS=200
RMC_IMPORT_MAX_QUERIES_PER_RUN=500
# Safety switch: only MARKET imports are allowed unless this is explicitly true.
RMC_IMPORT_ENABLE_BULK_SCOPES=false

# Existing email delivery used for onboarding invitations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
