# CONCRETE KING / TrackMyRMC — environment variables
# ---------------------------------------------------
# Every variable the server actually reads (extracted from server/src). Set these
# on the Cloud Run service. Put anything sensitive in Secret Manager and attach it
# with `--set-secrets`; put non-secret config with `--set-env-vars`.
# DO NOT commit real values.

########## Required — the app will not boot / core flows break without these ##########
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME   # HOST depends on your DB path — see note (A)
JWT_SECRET=                # REQUIRED. No fallback — server refuses to start without it.
NODE_ENV=production
# PORT is injected by Cloud Run (8080). Do NOT set it manually there. Locally you may set PORT.

########## Public URLs / CORS ##########
APP_URL=https://trackmyrmc.com        # used for password-reset links & Twilio callback signature
PUBLIC_URL=https://trackmyrmc.com     # same purpose; keep in sync with APP_URL
CORS_ALLOWED_ORIGINS=https://trackmyrmc.com,https://www.trackmyrmc.com   # comma-separated; add app origins as needed

########## Email (SMTP) ##########
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notification@trackmyrmc.com
SMTP_SYNC_FROM_ENV=1                   # on boot, sync these SMTP values into app settings and verify

########## Web push (VAPID) ##########
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@goldetech.com

########## WhatsApp (Meta Cloud API) ##########
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v21.0
WHATSAPP_META_LANG=en
WHATSAPP_META_OTP_TEMPLATE=            # approved AUTHENTICATION template name

########## SMS OTP (Twilio) ##########
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

########## Google Maps / Places ##########
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=               # preferred, domain-restricted browser key
GOOGLE_MAPS_MAP_ID=                    # optional cloud-styled map id
GOOGLE_PLACES_API_KEY=

########## Auth / admin / misc ##########
AUTHORITY_BOOTSTRAP_PASSWORD=
AUTHORITY_EMAILS=                      # comma-separated authority emails
CLERK_SECRET_KEY=                      # optional — Clerk SSO token exchange
REVIEW_DEMO_EMAIL=                     # app-store reviewer demo account
REVIEW_DEMO_OTP=
LIVE_GPS_STALE_MS=                     # optional tuning (ms) for GPS staleness

########## KYC (Aadhaar / DigiLocker) — optional feature ##########
KYC_ENABLED=false
KYC_PROVIDER=
KYC_BASE_URL=
KYC_API_KEY=
KYC_API_SECRET=
KYC_API_VERSION=

########## AI Help Agent (Gemini) — see note (B) ##########
AI_INTEGRATIONS_GEMINI_API_KEY=        # a real Google AI Studio key off-Replit
AI_INTEGRATIONS_GEMINI_BASE_URL=       # e.g. https://generativelanguage.googleapis.com — TEST before relying on it

########## Object storage — see note (C): Replit-bound, needs attention off-Replit ##########
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# REPLIT_DEV_DOMAIN is a Replit-only value; it is ignored on GCP.

# ---------------------------------------------------------------------------
# NOTES
# (A) DATABASE_URL host & TLS: the app disables Postgres TLS ONLY when the
#     DATABASE_URL STRING CONTAINS the literal substring "localhost". Pick ONE path:
#       * Built-in Cloud SQL socket (recommended; used by cloudbuild.yaml): deploy with
#         --add-cloudsql-instances=<INSTANCE_CONNECTION_NAME> (Unix socket at
#         /cloudsql/<INSTANCE>). Route to the socket via the ?host= query param while
#         keeping `localhost` in the string so TLS stays off (a socket needs no TLS):
#         postgresql://user:pass@localhost/db?host=/cloudsql/trackmyrmc-production:asia-south1:trackmyrmc-prod-db
#         (verified: pg-connection-string uses the ?host= param as the real target and
#         ignores the `localhost` authority for connecting). No sidecar needed.
#       * Auth Proxy sidecar (private): deploy deploy/service.yaml, which runs the Cloud
#         SQL Auth Proxy on localhost:5432. Use host `localhost`:
#         postgres://user:pass@localhost:5432/db  (app TLS off; the proxy encrypts
#         the hop to Cloud SQL).
#       * Public IP (simplest): give the instance a public IP and use that IP as the
#         host: postgres://user:pass@PUBLIC_IP:5432/db  (app negotiates SSL,
#         rejectUnauthorized:false). Do NOT use `localhost` here.
# (B) AI Help Agent: base URL + key are env-configurable, so it MAY work off-Replit
#     with a real Google AI Studio key + the native generateContent endpoint —
#     verify with a test chat. If unset, the AI help feature simply stays disabled.
# (C) Object storage (proof photos, bills, attachments): the integration fetches
#     GCS credentials from a Replit sidecar at 127.0.0.1:1106 (hardcoded, not env).
#     Off Replit that endpoint does not exist, so file upload/serving will not work
#     until this layer is pointed at a real GCS bucket. This is the ONE piece that
#     needs a code change later — out of scope for this "no app-code-change" package.
# ---------------------------------------------------------------------------
