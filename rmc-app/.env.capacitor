# Build-time settings for the native (Capacitor / Android) bundle.
# Used by `pnpm build:native` (vite build --mode capacitor).
#
# The wrapped Android app has no dev proxy and is not served same-origin, so it
# MUST talk to the deployed backend over the internet. Set this to the public
# URL of your deployed CONCRETE KING backend (no trailing slash). Change it if
# your live domain differs from the default below.
VITE_API_BASE_URL=https://www.trackmyrmc.com

# Disable the PWA service worker for the native build: the WebView must always
# load the freshly bundled assets and reach the live API, and web-push (VAPID)
# does not work inside a native WebView.
VITE_DISABLE_PWA=1
