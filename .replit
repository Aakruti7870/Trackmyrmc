modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd rmc-app && pnpm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && pnpm test && cd ../rmc-app && pnpm test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && pnpm build && cd ../rmc-app && pnpm build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "lint"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd rmc-app && pnpm lint"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/mockup-sandbox"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 23636
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "23636"
BASE_PATH = "/__mockup/"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && pnpm dev"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 23636
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "NODE_ENV=production node server/dist/index.js"]
build = ["bash", "-c", "cd rmc-app && pnpm build && cd ../server && pnpm build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[objectStorage]
defaultBucketID = "replit-objstore-7b3ab1c0-032c-43db-81ec-852e30af83da"

[userenv]

[userenv.shared]
VITE_CLERK_PUBLISHABLE_KEY = "pk_test_ZGV2b3RlZC1raWQtMzcuY2xlcmsuYWNjb3VudHMuZGV2JA"
WHATSAPP_META_PHONE_NUMBER_ID = "1281365125049836"
VAPID_PUBLIC_KEY = "BL0iTHXdZu_N0yD8IYBdGUX-_6GBFXy_lp4hsXOzgz7Yoe-N_xIcx2aCw040pOeNAIW-P_kX_RGJPcJFw_JSGWY"
VAPID_SUBJECT = "mailto:notifications@concreteking.app"
TWILIO_VERIFY_SERVICE_SID = "VAa36a1c5af68b0226f11cd3c0eb151239"
APP_URL = "https://trackmyrmc.com"
SMTP_SYNC_FROM_ENV = "1"
REVIEW_DEMO_EMAIL = "reviewer@trackmyrmc.com"
